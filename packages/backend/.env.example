DATABASE_URL=postgresql://power_budget_app:power_budget_app@localhost:5432/power_budget
MIGRATION_DATABASE_URL=postgresql://power_budget:power_budget@localhost:5432/power_budget
REDIS_URL=redis://localhost:6379

# === Auth (required) ===
# HS256 signing secret, >= 32 bytes; the API refuses to boot without it.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# === HTTP ===
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# === Resend bounce webhook (whsec_...); unset = webhook rejects everything ===
RESEND_WEBHOOK_SECRET=

# === Sentry error tracking ===
SENTRY_DSN=
SENTRY_RELEASE=
