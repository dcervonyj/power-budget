<mjml>
  <mj-head>
    <mj-title>You are invited to a household</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.5" color="#333333" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#2d6a4f">Join a household on Power Budget</mj-text>
        <mj-divider border-color="#2d6a4f" border-width="2px" />
        <mj-text>Hi,</mj-text>
        <mj-text>{{inviterName}} invited you to share the household &quot;{{householdName}}&quot; on Power Budget.</mj-text>
        <mj-text>Sign in or create an account with this email address, then use the button below. The link works once and expires in 7 days.</mj-text>
        <mj-button background-color="#2d6a4f" color="#ffffff" href="{{link}}">Accept the invite</mj-button>
        <mj-text color="#888888" font-size="13px">If you did not expect this invite, you can ignore this email.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
