<mjml>
  <mj-head>
    <mj-title>Your sign-in link</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.5" color="#333333" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#2d6a4f">Sign in to Power Budget</mj-text>
        <mj-divider border-color="#2d6a4f" border-width="2px" />
        <mj-text>Hi,</mj-text>
        <mj-text>Use the button below to sign in. The link works once and expires in 15 minutes.</mj-text>
        <mj-button background-color="#2d6a4f" color="#ffffff" href="{{link}}">Sign in</mj-button>
        <mj-text color="#888888" font-size="13px">If you did not ask for this link, you can ignore this email.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
