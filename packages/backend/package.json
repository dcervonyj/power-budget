{
  "name": "@power-budget/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/src/worker.main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node drizzle/migrate.mjs",
    "db:roles": "node drizzle/roles.mjs",
    "db:check": "bash drizzle/check-drift.sh",
    "db:reset": "drizzle-kit drop && node drizzle/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx drizzle/seed/0001_seed_categories.ts",
    "db:seed:perf": "tsx drizzle/seed/0002_seed_perf_fixture.ts",
    "test:integration": "vitest run --config src/test/integration/vitest.integration.config.ts",
    "generate:openapi": "tsx src/generate-openapi.ts",
    "check:openapi": "pnpm run generate:openapi && pnpm exec prettier --write openapi.json && git diff --exit-code openapi.json",
    "copy:i18n": "cp -r ../web/public/locales ./src/i18n/locales/"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.2",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6",
    "@power-budget/core": "workspace:*",
    "@sentry/node": "^10.53.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.5",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mjml": "^5.2.1",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2",
    "resend": "^6.12.3",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.18",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.2.6",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^4.0.0"
  }
}
