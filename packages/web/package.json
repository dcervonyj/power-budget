{
  "name": "@power-budget/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:gallery": "vite build --mode gallery",
    "preview:gallery": "vite preview --mode gallery --port 4174 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep smoke",
    "test:visual": "bash e2e/visual/run-in-docker.sh",
    "test:visual:update": "bash e2e/visual/run-in-docker.sh --update-snapshots",
    "test:e2e:stack": "TEST_ENV=e2e playwright test --project=chromium",
    "test:a11y": "pnpm run build:gallery && PW_VISUAL=1 playwright test --project=a11y",
    "test:a11y:stack": "TEST_ENV=e2e playwright test --project=a11y-stack",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --out-file /tmp/power-budget-web-message-ids.json --format simple --id-interpolation-pattern '[sha512:contenthash:base64:6]' && node src/i18n/ExtractedMessageFilter.mjs /tmp/power-budget-web-message-ids.json public/locales/en public/locales/en.json /tmp/power-budget-web-needs-translation.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@power-budget/core": "workspace:*",
    "@power-budget/design-tokens": "workspace:^",
    "@power-budget/shared-app": "workspace:*",
    "@sentry/react": "^10.76.2",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.0.7",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^10.1.9",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@formatjs/cli": "^6.16.35",
    "@formatjs/cli-lib": "^8.7.0",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-formatjs": "~6.6.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.11"
  },
  "eslintRatchet": true
}
