body{margin:0}
a{color:inherit}a:hover{color:inherit}
button,input{font:inherit;color:inherit}
button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid currentColor;outline-offset:2px}
@keyframes d7-rise{from{opacity:0;transform:translateY(18px) scale(.96)}}
@keyframes d7-drift1{to{transform:translate(90px,70px) scale(1.12)}}
@keyframes d7-drift2{to{transform:translate(-110px,-60px) scale(.92)}}
@keyframes d7-drift3{to{transform:translate(80px,-70px) scale(1.08)}}
@keyframes d7-float{to{transform:translate(-24px,18px)}}
@keyframes d7-breathe{from{opacity:.6}to{opacity:1}}
@keyframes d7-glint{from{left:0%}}
@keyframes d7-sheen{from{transform:translateX(-130%) skewX(-14deg)}to{transform:translateX(340%) skewX(-14deg)}}
@keyframes d7-live{50%{opacity:.35}}
@keyframes d7-pop{from{opacity:0;transform:translateY(6px)}}
@keyframes d7-sheet{from{transform:translateY(100%)}}
@keyframes d7-fade{from{opacity:0}}
@keyframes d7-sweep{0%{transform:translateX(-140%) skewX(-16deg)}14%,100%{transform:translateX(380%) skewX(-16deg)}}
@keyframes d7-film{from{background-position:0% 50%}to{background-position:100% 50%}}
@keyframes d7-flicker{0%,100%{opacity:1}38%{opacity:.84}52%{opacity:.97}71%{opacity:.9}}
@keyframes d7-travel{0%{left:0%;opacity:0}12%{opacity:1}88%{opacity:1}100%{left:100%;opacity:0}}
@keyframes d7-rise-v{0%{bottom:0%;opacity:0}12%{opacity:1}88%{opacity:1}100%{bottom:100%;opacity:0}}
@keyframes d7-twinkle{0%,100%{opacity:0;transform:scale(.4)}50%{opacity:1;transform:scale(1)}}
@keyframes d7-caustic{from{transform:translate(-6px,2px) rotate(-2deg)}to{transform:translate(6px,-2px) rotate(2deg)}}
@keyframes d7-bloom{from{opacity:.7}to{opacity:1}}
@keyframes d7-reveal{from{clip-path:inset(0 100% 0 0)}}
@keyframes d7-reveal-v{from{clip-path:inset(100% 0 0 0)}}
@keyframes d7-glowin{from{opacity:0;transform:scale(.6)}}
@media (prefers-reduced-motion: reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
"
`;

