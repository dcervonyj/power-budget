{
  "name": "@power-budget/mobile",
  "private": true,
  "version": "0.0.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run && jest",
    "build:gallery": "EXPO_PUBLIC_GALLERY=1 expo export --platform web --output-dir dist-gallery",
    "test:export": "node --test e2e-web/production-export.test.mjs",
    "test:visual": "bash e2e-web/visual/run-in-docker.sh",
    "test:visual:update": "bash e2e-web/visual/run-in-docker.sh --update-snapshots",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --out-file /tmp/power-budget-mobile-message-ids.json --format simple --id-interpolation-pattern '[sha512:contenthash:base64:6]' && node src/infrastructure/locale/ExtractedMessageFilter.mjs /tmp/power-budget-mobile-message-ids.json assets/locales/en assets/locales/en.json /tmp/power-budget-mobile-needs-translation.json"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@power-budget/core": "workspace:*",
    "@power-budget/design-tokens": "workspace:^",
    "@power-budget/shared-app": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@sentry/react-native": "~8.28.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-font": "~58.0.9",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "^10.1.9",
    "react-native": "0.88.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@formatjs/cli": "^6.16.35",
    "@formatjs/cli-lib": "^8.7.0",
    "@golevelup/ts-jest": "^3.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^25.8.0",
    "@types/react": "~19.3.0",
    "eslint-plugin-formatjs": "~6.6.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "eslintRatchet": true
}
