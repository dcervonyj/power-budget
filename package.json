{
  "name": "power-budget",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm')) { console.error('Use pnpm'); process.exit(1); }\"",
    "prepare": "husky",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "dev:db:up": "docker compose up -d --wait",
    "dev:db:down": "docker compose down",
    "dev:db:reset": "bash scripts/db-reset.sh",
    "dev:db:logs": "docker compose logs -f",
    "i18n:extract": "turbo run i18n:extract"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "turbo": "^2.10",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,cjs,mjs}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@unicode/unicode-17.0.0": "1.6.17",
      "undici@<7": "^6.29.1",
      "undici@>=7": "^7.30.1",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=2 <3": "^2.1.7",
      "brace-expansion@>=4": "^5.0.12",
      "@xmldom/xmldom@<0.9": "^0.8.15",
      "@xmldom/xmldom@>=0.9": "^0.9.12",
      "js-yaml@<5": "^4.3.2",
      "js-yaml@>=5": "^5.4.1",
      "fast-uri": "^3.1.9",
      "joi": "^17.13.8",
      "postcss": "^8.5.23",
      "postcss-selector-parser": "^7.1.6",
      "nanoid@<4": "^3.3.18",
      "svgo": "^4.1.0",
      "browserslist": "^4.28.7",
      "fastify": "^5.12.7",
      "source-map-js": "^1.2.2",
      "compression": "^1.8.2",
      "follow-redirects": "^1.16.1",
      "ws@<8": "^7.5.11",
      "ws@>=8": "^8.21.0",
      "shell-quote": "^1.9.0",
      "esbuild@<0.25": "^0.25.12",
      "esbuild@>=0.27 <0.28.1": "^0.28.1",
      "fast-xml-parser@<5": "^5.7.0",
      "baseline-browser-mapping": "^2.11.0"
    },
    "packageExtensions": {
      "react-native-reanimated": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      }
    }
  }
}
