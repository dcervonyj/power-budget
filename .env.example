# Copy this file to .env for local development.
# DO NOT commit .env to git.
# These credentials are DEV-ONLY. Never use in staging or production.

# === Docker Compose service ports (override to avoid conflicts) ===
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# === Postgres credentials (dev-only) ===
POSTGRES_USER=power_budget
POSTGRES_PASSWORD=power_budget
POSTGRES_DB=power_budget

# Least-privilege app role (no ownership, no DDL), created on first `pnpm dev:db:up`.
APP_DB_USER=power_budget_app
APP_DB_PASSWORD=power_budget_app

# === Application-level env vars (consumed by packages/backend & worker) ===
# App runtime connection: least-privilege app role.
DATABASE_URL=postgres://power_budget_app:power_budget_app@localhost:5432/power_budget
# Migrator/owner connection: used by `pnpm db:migrate`, `db:roles`, drizzle-kit. Never give it to the running app.
MIGRATION_DATABASE_URL=postgres://power_budget:power_budget@localhost:5432/power_budget
REDIS_URL=redis://localhost:6379
# Free-tier topology (ADR-002): "true" runs the BullMQ worker inside the API process.
START_WORKER=false
# Comma-separated exact browser origins allowed by CORS; "*.domain" allows direct HTTPS
# subdomains. A bare "*" is rejected at boot. Unset = no cross-origin access.
CORS_ORIGINS=http://localhost:5173
# Swagger UI at /docs is served only when this is "true" (keep it off on deployments).
SWAGGER_ENABLED=true

# === Auth ===
# REQUIRED: HS256 signing secret, at least 32 bytes. The API refuses to boot without it.
# Generate with: openssl rand -base64 48
JWT_SECRET=<run: openssl rand -base64 48>

# === Email (Resend) ===
# Notification email goes out through Resend only (no SMTP channel). Required on
# staging/production: the worker refuses to boot without it. Empty locally = sends fail
# and are retried, nothing else breaks.
RESEND_API_KEY=
# Optional sender; the domain must be verified in Resend.
EMAIL_FROM=Power Budget <noreply@powerbudget.app>
# Web app origin used in email links (magic-link sign-in, invites).
APP_BASE_URL=http://localhost:5173

# === Encryption ===
# Encryption KEK (32 random bytes, base64-encoded)
# Generate with: openssl rand -base64 32
KEK_BASE64=<run: openssl rand -base64 32>

# === Audit log PII redaction ===
# Amounts (in minor units) at or above this threshold are redacted in audit logs.
# 1000000 minor units = 10,000 in major units (e.g., 10,000 PLN)
AUDIT_REDACTION_THRESHOLD_MINOR=1000000

# === Resend bounce webhook ===
# Signing secret from the Resend webhook settings (whsec_...). Unset = the bounce
# webhook rejects every request.
RESEND_WEBHOOK_SECRET=

# Trusted proxy hops in front of the API (Fastify trustProxy). Decides which
# X-Forwarded-For entry is the client IP for the per-IP auth rate limit.
# Default 1 (Render's load balancer). Also accepts true/false or a CSV of proxy IPs/CIDRs.
TRUST_PROXY=1

# === GoCardless (Bank Account Data API) ===
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Leave empty to disable (DSNs are project-specific secrets; get them from sentry.io)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_AUTH_TOKEN=

# Web Sentry DSN
VITE_SENTRY_DSN=

# Mobile Sentry DSN
EXPO_PUBLIC_SENTRY_DSN=

# === Wise Personal API ===
WISE_API_BASE_URL=https://api.wise.com
